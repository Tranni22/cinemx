import tkinter as tk
from tkinter import messagebox
import subprocess
import threading
import queue
import sys

# Path to the engine (Change to real engine path when available)
ENGINE_PATH = r"C:\Users\Lenovo\Downloads\EMBRYO26\caro-ui\mock_engine.py"
ENGINE_CMD = [sys.executable, ENGINE_PATH] # Use python to run mock
# If using real exe, change ENGINE_CMD to [ENGINE_PATH]

class CaroGUI:
    def __init__(self, root, engine_path):
        self.root = root
        self.root.title("Caro Game - Engine Linked")
        self.engine_path = engine_path
        self.width = 15
        self.height = 19
        
        self.process = None
        self.msg_queue = queue.Queue()
        
        # UI Elements
        self.buttons = [[None for _ in range(self.width)] for _ in range(self.height)]
        self.create_board()
        
        self.start_engine()
        
        # Periodically check for engine messages
        self.root.after(100, self.process_engine_messages)

    def create_board(self):
        for y in range(self.height):
            for x in range(self.width):
                btn = tk.Button(self.root, width=2, height=1, command=lambda x=x, y=y: self.on_click(x, y))
                btn.grid(row=y, column=x)
                self.buttons[y][x] = btn

    def start_engine(self):
        self.process = subprocess.Popen(
            ENGINE_CMD,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        # Start a thread to read engine output
        threading.Thread(target=self.read_engine_output, daemon=True).start()
        # Send initialization command
        self.send_to_engine(f"START {self.width}")

    def read_engine_output(self):
        while True:
            if self.process.poll() is not None:
                break
            line = self.process.stdout.readline()
            if line:
                self.msg_queue.put(line.strip())

    def process_engine_messages(self):
        while not self.msg_queue.empty():
            msg = self.msg_queue.get()
            # Handle engine response protocol (e.g., "1234,5678")
            if "," in msg:
                try:
                    ex, ey = map(int, msg.split(","))
                    self.update_board(ex, ey, 'O')
                except ValueError:
                    pass
        self.root.after(100, self.process_engine_messages)

    def send_to_engine(self, command):
        if self.process and self.process.poll() is None:
            self.process.stdin.write(command + "\n")
            self.process.stdin.flush()

    def on_click(self, x, y):
        self.update_board(x, y, 'X')
        self.send_to_engine(f"TURN {x},{y}")

    def update_board(self, x, y, player):
        self.buttons[y][x].config(text=player, state=tk.DISABLED)

    def on_closing(self):
        if self.process:
            self.process.terminate()
        self.root.destroy()

if __name__ == "__main__":
    root = tk.Tk()
    app = CaroGUI(root, ENGINE_PATH)
    root.protocol("WM_DELETE_WINDOW", app.on_closing)
    root.mainloop()
