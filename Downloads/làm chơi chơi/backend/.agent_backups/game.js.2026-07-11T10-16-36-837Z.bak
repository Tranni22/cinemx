const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

// Fixed size for testing
canvas.width = 800;
canvas.height = 600;

function gameLoop() {
    ctx.fillStyle = '#228B22'; // Grass color
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    // Draw simple plant
    ctx.fillStyle = 'green';
    ctx.fillRect(50, 100, 50, 50);
    
    // Draw simple zombie
    ctx.fillStyle = 'red';
    ctx.fillRect(600, 100, 50, 50);
    
    requestAnimationFrame(gameLoop);
}

gameLoop();
