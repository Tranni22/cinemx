import subprocess
import time

ENGINE_PATH = r"C:\Users\Lenovo\Downloads\EMBRYO26\pbrain-embryo26_f.exe"
process = subprocess.Popen(
    [ENGINE_PATH],
    stdin=subprocess.PIPE,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    text=True
)

try:
    print("Sending START 15")
    process.stdin.write("START 15\n")
    process.stdin.flush()
    # Pbrain often returns 'OK' to START
    print(f"Got: '{process.stdout.readline().strip()}'")

    print("Sending TURN 7,7")
    process.stdin.write("TURN 7,7\n")
    process.stdin.flush()
    # Pbrain returns move in format: X,Y
    print(f"Got: '{process.stdout.readline().strip()}'")

    process.stdin.write("END\n")
    process.stdin.flush()
except Exception as e:
    print(f"Error: {e}")
finally:
    process.terminate()
